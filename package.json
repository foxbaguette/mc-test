{
  "name": "wax-mission-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "images": "node scripts/fetch-ipfs.mjs && node scripts/optimize-tool-images.mjs && node scripts/fetch-adventure-images.mjs && node scripts/fetch-card-images.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@wharfkit/session": "^1.5.0",
    "@wharfkit/wallet-plugin-anchor": "^1.7.3",
    "@wharfkit/wallet-plugin-cloudwallet": "^1.4.0",
    "@wharfkit/wallet-plugin-wombat": "^1.5.1",
    "@wharfkit/web-renderer": "^1.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
